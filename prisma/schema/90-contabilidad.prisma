// ═══════════════════════════════════════════════════════════════════════
//  CONTABILIDAD Y FISCAL (motor heredado de ContaVE, migrado a Decimal)
// ═══════════════════════════════════════════════════════════════════════
//
// Esta es la capa fiscal aislada: plan de cuentas VEN-NIF, asientos, libros
// del SENIAT, declaraciones de IVA e ISLR, retenciones, IGTF, ajuste por
// inflación y nómina LOTTT. El módulo operativo (ventas, compras, gastos)
// nunca calcula un impuesto por su cuenta: le pide el cálculo a esta capa.
//
// Empresa es el perfil fiscal 1:1 de una Organizacion (ver 10-nucleo).

model Empresa {
  id                      String  @id @default(cuid())
  nombre                  String
  rif                     String  @unique
  direccion               String?
  telefono                String?
  email                   String?
  esAgenteRetencionIVA    Boolean @default(false)
  esContribuyenteEspecial Boolean @default(false)
  alicuotaIVA             Decimal @default(16.0) @db.Decimal(7, 4)
  monedaFuncional         String  @default("VES")
  // Nómina: porcentajes configurables (varían por ley/clase de riesgo), con default legal usual
  porcentajeIVSSPatronal  Decimal @default(9) @db.Decimal(7, 4)
  porcentajeFAOVEmpleado  Decimal @default(1) @db.Decimal(7, 4)
  porcentajeFAOVPatronal  Decimal @default(2) @db.Decimal(7, 4)
  porcentajeINCES         Decimal @default(2) @db.Decimal(7, 4)
  diasPrestacionesPorMes  Decimal @default(5) @db.Decimal(9, 4)
  porcentajeUtilidades    Decimal @default(8.33) @db.Decimal(7, 4)
  // Calendario fiscal: día del mes siguiente en que vence la declaración de
  // IVA para el grupo de RIF de esta empresa (varía según el calendario anual
  // que publica el SENIAT). El usuario debe ajustarlo según su calendario oficial.
  diaVencimientoIVA       Int     @default(15)
  // Cuentas por cobrar/pagar: plazo de crédito por defecto (días) usado para
  // calcular la fecha de vencimiento y la antigüedad de saldos de cada factura.
  diasCreditoClientes     Int     @default(30)
  diasCreditoProveedores  Int     @default(30)

  organizacion        Organizacion?
  cuentas             Cuenta[]
  facturas            Factura[]
  asientos            Asiento[]
  tasaCambios         TasaCambio[]
  usuarios            UserEmpresa[]
  ejercicios          Ejercicio[]
  conciliaciones      ConciliacionBanco[]
  clientes            Cliente[]
  secuenciasDocumento SecuenciaDocumento[]
  indicesInflacion    IndiceInflacion[]
  ajustesInflacion    AjusteInflacion[]
  empleados           Empleado[]
  nominas             Nomina[]
  activosFijos        ActivoFijo[]
  pagos               Pago[]
  vacaciones          Vacacion[]
  liquidaciones       Liquidacion[]
  accionistas         Accionista[]
  actasAsamblea       ActaAsamblea[]
  auditLogs           AuditLog[]
  notificaciones      Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserEmpresa {
  id        String   @id @default(cuid())
  userId    String
  empresaId String
  rol       String   @default("CONTADOR")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, empresaId])
}

model Cuenta {
  id          String  @id @default(cuid())
  empresaId   String
  codigo      String
  nombre      String
  tipo        String
  naturaleza  String
  nivel       Int     @default(4)
  padreId     String?
  imputable   Boolean @default(true)
  uso         String?
  // Ajuste por inflación: si la cuenta representa una partida monetaria (efectivo,
  // cuentas por cobrar/pagar, impuestos) o no monetaria (activos fijos, inventario,
  // capital) — determina si se reexpresa por el índice de inflación del período.
  esMonetaria Boolean @default(true)

  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lineas         AsientoLinea[]
  conciliaciones ConciliacionBanco[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, uso])
}

model Factura {
  id                      String   @id @default(cuid())
  empresaId               String
  userId                  String
  tipo                    String
  rifContraparte          String
  nombreContraparte       String
  numeroFactura           String?
  numeroControl           String?
  ncf                     String?
  fechaEmision            DateTime
  fechaRegistro           DateTime @default(now())
  monedaOriginal          String   @default("VES")
  baseImponible           Decimal  @default(0) @db.Decimal(18, 4)
  montoExento             Decimal  @default(0) @db.Decimal(18, 4)
  montoExonerado          Decimal  @default(0) @db.Decimal(18, 4)
  alicuotaIVA             Decimal  @default(16.0) @db.Decimal(7, 4)
  montoIVA                Decimal  @default(0) @db.Decimal(18, 4)
  porcentajeRetencionIVA  Decimal? @db.Decimal(7, 4)
  montoRetencionIVA       Decimal? @db.Decimal(18, 4)
  tarifaISLRCodigo        String?
  porcentajeRetencionISLR Decimal? @db.Decimal(7, 4)
  baseRetencionISLR       Decimal? @db.Decimal(18, 4)
  montoRetencionISLR      Decimal? @db.Decimal(18, 4)
  // IGTF (Impuesto a las Grandes Transacciones Financieras, 3%): se activa si el
  // pago se hizo en divisas/cripto, o si la empresa es contribuyente especial y
  // el pago fue en efectivo. Se registra como gasto no recuperable.
  pagoDivisaOCripto       Boolean  @default(false)
  pagoEfectivo            Boolean  @default(false)
  porcentajeIGTF          Decimal? @db.Decimal(7, 4)
  montoIGTF               Decimal? @db.Decimal(18, 4)
  subtotal                Decimal  @default(0) @db.Decimal(18, 4)
  total                   Decimal  @default(0) @db.Decimal(18, 4)
  totalRetencion          Decimal  @default(0) @db.Decimal(18, 4)
  totalAPagar             Decimal  @default(0) @db.Decimal(18, 4)
  tasaCambio              Decimal? @db.Decimal(18, 8)
  totalMonedaFuncional    Decimal  @default(0) @db.Decimal(18, 4)
  descripcion             String?
  imagenUrl               String?
  imagenData              String?
  // Solo relevante cuando tipo es NOTA_CREDITO o NOTA_DEBITO: indica si la nota
  // afecta una venta (true) o una compra (false), para el débito/crédito fiscal
  // de la declaración de IVA. Se ignora para los demás tipos.
  ncfAfectaVenta          Boolean  @default(true)
  estado                  String   @default("REGISTRADA")
  // Cuentas por cobrar/pagar: se actualizan al registrar pagos (ver modelo Pago).
  // Solo aplican a facturas tipo VENTA (CxC) y COMPRA (CxP); GASTO_MENOR se
  // paga de contado por caja chica y no genera partida abierta.
  montoPagado             Decimal  @default(0) @db.Decimal(18, 4)
  estadoPago              String   @default("PENDIENTE") // PENDIENTE | PARCIAL | PAGADA

  asiento Asiento?
  pagos   Pago[]
  // Documentos operativos que generaron esta factura fiscal.
  venta   Venta?
  compra  Compra?
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, tipo, fechaEmision])
  @@index([empresaId, ncf])
}

model Asiento {
  id          String  @id @default(cuid())
  empresaId   String
  userId      String
  numero      Int
  fecha       DateTime
  descripcion String
  referencia  String?
  tipo        String  @default("MANUAL")
  facturaId   String? @unique
  fuente      String  @default("manual")

  lineas  AsientoLinea[]
  empresa Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario User           @relation(fields: [userId], references: [id])
  factura Factura?       @relation(fields: [facturaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, fecha])
  @@index([empresaId, numero])
}

model AsientoLinea {
  id          String  @id @default(cuid())
  asientoId   String
  cuentaId    String
  cuenta      Cuenta  @relation(fields: [cuentaId], references: [id])
  debit       Decimal @default(0) @db.Decimal(18, 4)
  credit      Decimal @default(0) @db.Decimal(18, 4)
  descripcion String?
  asiento     Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([asientoId])
  @@index([cuentaId])
}

model Ejercicio {
  id                String    @id @default(cuid())
  empresaId         String
  ano               Int
  estado            String    @default("ABIERTO")
  fechaInicio       DateTime
  fechaCierre       DateTime
  asientoCierreId   String?
  asientoAperturaId String?
  utilidadNeta      Decimal?  @db.Decimal(18, 4)
  islrEstimado      Decimal?  @db.Decimal(18, 4)
  cerradoPor        String?
  cerradoEn         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, ano])
  @@index([empresaId, estado])
}

model ConciliacionBanco {
  id                  String  @id @default(cuid())
  empresaId           String
  cuentaId            String
  mes                 Int
  ano                 Int
  saldoInicialLibro   Decimal @default(0) @db.Decimal(18, 4)
  saldoInicialBanco   Decimal @default(0) @db.Decimal(18, 4)
  saldoFinalLibro     Decimal @default(0) @db.Decimal(18, 4)
  saldoFinalBanco     Decimal @default(0) @db.Decimal(18, 4)
  depositosEnTransito Decimal @default(0) @db.Decimal(18, 4)
  chequesPendientes   Decimal @default(0) @db.Decimal(18, 4)
  notasCredito        Decimal @default(0) @db.Decimal(18, 4)
  notasDebito         Decimal @default(0) @db.Decimal(18, 4)
  estado              String  @default("PENDIENTE")
  diferencia          Decimal @default(0) @db.Decimal(18, 4)
  notas               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cuenta      Cuenta            @relation(fields: [cuentaId], references: [id])
  movimientos MovimientoBanco[]

  @@unique([empresaId, cuentaId, mes, ano])
  @@index([empresaId, mes, ano])
}

model MovimientoBanco {
  id             String   @id @default(cuid())
  conciliacionId String
  fecha          DateTime
  descripcion    String
  referencia     String?
  monto          Decimal  @db.Decimal(18, 4)
  tipo           String
  conciliado     Boolean  @default(false)
  asientoLineaId String?

  createdAt DateTime @default(now())

  conciliacion ConciliacionBanco @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)

  @@index([conciliacionId])
  @@index([conciliacionId, conciliado])
}

// Correlativo atómico por empresa y tipo de documento (ej. FACTURA_VENTA),
// usado para numerar facturas emitidas sin colisionar con numeroControl/numeroFactura
// de facturas registradas (compra/venta ya emitidas por terceros).
model SecuenciaDocumento {
  id              String   @id @default(cuid())
  empresaId       String
  tipo            String
  siguienteNumero Int      @default(1)
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, tipo])
}

// ───────────────────────────────────────────────────────────────────────
//  AJUSTE POR INFLACIÓN (reexpresión simplificada, nivel general de precios)
// ───────────────────────────────────────────────────────────────────────

model IndiceInflacion {
  id        String   @id @default(cuid())
  empresaId String
  mes       Int
  ano       Int
  indice    Decimal  @db.Decimal(18, 8)
  fuente    String   @default("MANUAL")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([empresaId, mes, ano])
}

model AjusteInflacion {
  id                           String  @id @default(cuid())
  empresaId                    String
  mes                          Int
  ano                          Int
  indiceInicial                Decimal @db.Decimal(18, 8)
  indiceFinal                  Decimal @db.Decimal(18, 8)
  factorReexpresion            Decimal @db.Decimal(18, 8)
  totalReexpresadoActivos      Decimal @default(0) @db.Decimal(18, 4)
  resultadoExposicionInflacion Decimal @default(0) @db.Decimal(18, 4)
  estado                       String  @default("BORRADOR")
  asientoId                    String?
  empresa                      Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, mes, ano])
}

// ───────────────────────────────────────────────────────────────────────
//  NÓMINA
// ───────────────────────────────────────────────────────────────────────

model Empleado {
  id                     String    @id @default(cuid())
  empresaId              String
  cedula                 String
  nombre                 String
  cargo                  String?
  fechaIngreso           DateTime
  salarioBase            Decimal   @db.Decimal(18, 4)
  activo                 Boolean   @default(true)
  // LOTTT: egreso y garantía de prestaciones sociales acumulada mes a mes
  // (Art. 142 lit. a) — se compara contra el cálculo retroactivo (lit. c) al liquidar.
  fechaEgreso            DateTime?
  motivoEgreso           String? // RENUNCIA | DESPIDO_JUSTIFICADO | DESPIDO_INJUSTIFICADO | MUTUO_ACUERDO
  prestacionesAcumuladas Decimal   @default(0) @db.Decimal(18, 4)
  // Comisión sobre ventas, para el personal que vende.
  porcentajeComision     Decimal   @default(0) @db.Decimal(7, 4)

  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles    NominaDetalle[]
  vacaciones  Vacacion[]
  liquidacion Liquidacion?
  membresia   Membresia?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, cedula])
}

model Nomina {
  id                     String    @id @default(cuid())
  empresaId              String
  mes                    Int
  ano                    Int
  fechaPago              DateTime?
  estado                 String    @default("BORRADOR")
  totalSueldos           Decimal   @default(0) @db.Decimal(18, 4)
  totalBonoAlimentacion  Decimal   @default(0) @db.Decimal(18, 4)
  totalDeducciones       Decimal   @default(0) @db.Decimal(18, 4)
  totalAportesPatronales Decimal   @default(0) @db.Decimal(18, 4)
  totalPrestaciones      Decimal   @default(0) @db.Decimal(18, 4)
  totalUtilidades        Decimal   @default(0) @db.Decimal(18, 4)
  totalNeto              Decimal   @default(0) @db.Decimal(18, 4)
  asientoId              String?

  empresa  Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles NominaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, mes, ano])
}

model NominaDetalle {
  id                    String  @id @default(cuid())
  nominaId              String
  empleadoId            String
  salarioBase           Decimal @db.Decimal(18, 4)
  bonoAlimentacion      Decimal @default(0) @db.Decimal(18, 4)
  deduccionIVSS         Decimal @default(0) @db.Decimal(18, 4)
  deduccionFAOV         Decimal @default(0) @db.Decimal(18, 4)
  totalDeducciones      Decimal @default(0) @db.Decimal(18, 4)
  aportePatronalIVSS    Decimal @default(0) @db.Decimal(18, 4)
  aportePatronalFAOV    Decimal @default(0) @db.Decimal(18, 4)
  aportePatronalINCES   Decimal @default(0) @db.Decimal(18, 4)
  provisionPrestaciones Decimal @default(0) @db.Decimal(18, 4)
  provisionUtilidades   Decimal @default(0) @db.Decimal(18, 4)
  netoAPagar            Decimal @default(0) @db.Decimal(18, 4)

  nomina   Nomina   @relation(fields: [nominaId], references: [id], onDelete: Cascade)
  empleado Empleado @relation(fields: [empleadoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([nominaId, empleadoId])
  @@index([nominaId])
}

// Vacaciones disfrutadas (LOTTT Art. 190-192): 15 días de disfrute + 1 día
// adicional por cada año de servicio a partir del segundo (máx. 15
// adicionales), y bono vacacional con el mismo esquema de días.
model Vacacion {
  id                  String   @id @default(cuid())
  empresaId           String
  empleadoId          String
  fechaInicio         DateTime
  fechaFin            DateTime
  diasDisfrutados     Decimal  @db.Decimal(9, 4)
  montoVacaciones     Decimal  @db.Decimal(18, 4)
  montoBonoVacacional Decimal  @db.Decimal(18, 4)
  asientoId           String?  @unique
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleado            Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([empleadoId])
}

// Liquidación final de un empleado (LOTTT Art. 142 y 92). Un solo registro
// por empleado (no se permite re-liquidar).
model Liquidacion {
  id                        String   @id @default(cuid())
  empresaId                 String
  empleadoId                String   @unique
  fechaEgreso               DateTime
  motivoEgreso              String
  aniosServicio             Decimal  @db.Decimal(9, 4)
  salarioIntegralDiario     Decimal  @db.Decimal(18, 4)
  prestacionesSociales      Decimal  @db.Decimal(18, 4)
  vacacionesVencidas        Decimal  @db.Decimal(18, 4)
  vacacionesFraccionadas    Decimal  @db.Decimal(18, 4)
  bonoVacacionalFraccionado Decimal  @db.Decimal(18, 4)
  utilidadesFraccionadas    Decimal  @db.Decimal(18, 4)
  indemnizacionDespido      Decimal  @default(0) @db.Decimal(18, 4)
  totalLiquidacion          Decimal  @db.Decimal(18, 4)
  asientoId                 String?  @unique
  empresa                   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleado                  Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
}

// ───────────────────────────────────────────────────────────────────────
//  ACTIVOS FIJOS Y DEPRECIACIÓN
// ───────────────────────────────────────────────────────────────────────

model ActivoFijo {
  id                    String  @id @default(cuid())
  empresaId             String
  nombre                String
  cuentaActivoId        String
  costoAdquisicion      Decimal @db.Decimal(18, 4)
  fechaAdquisicion      DateTime
  vidaUtilMeses         Int
  valorResidual         Decimal @default(0) @db.Decimal(18, 4)
  metodoDepreciacion    String  @default("LINEA_RECTA")
  depreciacionAcumulada Decimal @default(0) @db.Decimal(18, 4)
  estado                String  @default("ACTIVO")

  empresa     Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos MovimientoDepreciacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, estado])
}

model MovimientoDepreciacion {
  id                String     @id @default(cuid())
  activoFijoId      String
  mes               Int
  ano               Int
  montoDepreciado   Decimal    @db.Decimal(18, 4)
  valorLibroDespues Decimal    @db.Decimal(18, 4)
  asientoId         String?
  activoFijo        ActivoFijo @relation(fields: [activoFijoId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())

  @@unique([activoFijoId, mes, ano])
}

// ───────────────────────────────────────────────────────────────────────
//  LIBRO DE ACCIONISTAS Y LIBRO DE ACTAS (registro societario)
// ───────────────────────────────────────────────────────────────────────

model Accionista {
  id             String   @id @default(cuid())
  empresaId      String
  nombre         String
  identificacion String // cédula o RIF
  numeroAcciones Decimal  @db.Decimal(18, 4)
  fechaIngreso   DateTime @default(now())
  activo         Boolean  @default(true)
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, identificacion])
}

// Correlativo de actas por empresa. accionesRepresentadas se usa junto con
// el total de acciones vigente (suma de Accionista.numeroAcciones activos)
// para calcular el quórum de la asamblea.
model ActaAsamblea {
  id                    String   @id @default(cuid())
  empresaId             String
  numero                Int
  fecha                 DateTime
  tipo                  String // ORDINARIA | EXTRAORDINARIA
  lugar                 String?
  agenda                String
  acuerdos              String
  asistentes            String // texto libre: nombres de accionistas/representantes presentes
  accionesRepresentadas Decimal  @default(0) @db.Decimal(18, 4)
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@unique([empresaId, numero])
}

// ───────────────────────────────────────────────────────────────────────
//  NOTIFICACIONES POR EMAIL
// ───────────────────────────────────────────────────────────────────────

// Cola de notificaciones (vencimientos fiscales próximos, facturas por
// cobrar vencidas). El envío real requiere configurar RESEND_API_KEY como
// variable de entorno — sin eso, quedan generadas pero en estado ERROR con
// un mensaje explicando qué falta. entidadId se usa para no duplicar el
// aviso de un mismo vencimiento/factura ya notificado.
model Notificacion {
  id           String    @id @default(cuid())
  empresaId    String
  tipo         String // VENCIMIENTO_FISCAL | CXC_VENCIDA | STOCK_MINIMO | GASTO_RECURRENTE
  destinatario String
  asunto       String
  cuerpo       String
  entidadId    String?
  estado       String    @default("PENDIENTE") // PENDIENTE | ENVIADA | ERROR
  errorMensaje String?
  enviadaAt    DateTime?
  empresa      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([empresaId, estado])
}
