// ContaVE - Schema para PostgreSQL (Supabase)
// Este schema es idéntico al de SQLite pero usando el provider postgresql
// Para usar con Supabase:
// 1. Copia este archivo a prisma/schema.prisma (reemplazando el actual)
// 2. Configura DATABASE_URL en .env con tu string de conexión de Supabase
// 3. Ejecuta: bun run db:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────
//  USUARIOS Y EMPRESAS (multi-tenant con roles)
// ───────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("CONTADOR") // SUPER_ADMIN, ADMIN, CONTADOR, AUXILIAR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresas UserEmpresa[]
  facturas Factura[]
  asientos Asiento[]
  sesiones Sesion[]
  pagos    Pago[]

  @@map("user")
}

model Empresa {
  id                      String               @id @default(cuid())
  nombre                  String
  rif                     String               @unique
  direccion               String?
  telefono                String?
  email                   String?
  esAgenteRetencionIVA    Boolean              @default(false)
  esContribuyenteEspecial Boolean              @default(false)
  alicuotaIVA             Float                @default(16.0)
  monedaFuncional         String               @default("VES")
  // Nómina: porcentajes configurables (varían por ley/clase de riesgo), con default legal usual
  porcentajeIVSSPatronal  Float                @default(9)
  porcentajeFAOVEmpleado  Float                @default(1)
  porcentajeFAOVPatronal  Float                @default(2)
  porcentajeINCES         Float                @default(2)
  diasPrestacionesPorMes  Float                @default(5)
  porcentajeUtilidades    Float                @default(8.33)
  // Calendario fiscal: día del mes siguiente en que vence la declaración de
  // IVA para el grupo de RIF de esta empresa (varía según el calendario anual
  // que publica el SENIAT). El usuario debe ajustarlo según su calendario oficial.
  diaVencimientoIVA       Int                  @default(15)
  // Cuentas por cobrar/pagar: plazo de crédito por defecto (días) usado para
  // calcular la fecha de vencimiento y la antigüedad de saldos de cada factura.
  diasCreditoClientes     Int                  @default(30)
  diasCreditoProveedores  Int                  @default(30)
  cuentas                 Cuenta[]
  facturas                Factura[]
  asientos                Asiento[]
  tasaCambios             TasaCambio[]
  usuarios                UserEmpresa[]
  ejercicios              Ejercicio[]
  conciliaciones          ConciliacionBanco[]
  clientes                Cliente[]
  secuenciasDocumento     SecuenciaDocumento[]
  indicesInflacion        IndiceInflacion[]
  ajustesInflacion        AjusteInflacion[]
  empleados               Empleado[]
  nominas                 Nomina[]
  activosFijos            ActivoFijo[]
  productos               Producto[]
  pagos                   Pago[]
  vacaciones              Vacacion[]
  liquidaciones           Liquidacion[]
  accionistas             Accionista[]
  actasAsamblea           ActaAsamblea[]
  auditLogs               AuditLog[]
  notificaciones          Notificacion[]
  // Módulo Restaurante (administración diaria del negocio de comida)
  restFondos              RestFondo[]
  restMovimientos         RestMovimientoFondo[]
  restCierres             RestCierreDiario[]
  restGastos              RestGasto[]
  restProveedores         RestProveedor[]
  restNotas               RestNotaProveedor[]
  restPagos               RestPagoProveedor[]
  restCuentasCobrar       RestCuentaCobrar[]
  restGastosFijos         RestGastoFijo[]
  restPersonal            RestPersonal[]
  restNominas             RestNominaSemana[]
  restIncidencias         RestIncidencia[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model UserEmpresa {
  id        String   @id @default(cuid())
  userId    String
  empresaId String
  rol       String   @default("CONTADOR")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, empresaId])
}

model Sesion {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Cuenta {
  id             String              @id @default(cuid())
  empresaId      String
  codigo         String
  nombre         String
  tipo           String
  naturaleza     String
  nivel          Int                 @default(4)
  padreId        String?
  imputable      Boolean             @default(true)
  uso            String?
  // Ajuste por inflación: si la cuenta representa una partida monetaria (efectivo,
  // cuentas por cobrar/pagar, impuestos) o no monetaria (activos fijos, inventario,
  // capital) — determina si se reexpresa por el índice de inflación del período.
  esMonetaria    Boolean             @default(true)
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lineas         AsientoLinea[]
  conciliaciones ConciliacionBanco[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, uso])
}

model TasaCambio {
  id        String   @id @default(cuid())
  empresaId String
  fecha     DateTime
  monedaRef String   @default("USD")
  tasa      Float
  fuente    String   @default("BCV")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([empresaId, fecha, monedaRef])
}

model Factura {
  id                      String   @id @default(cuid())
  empresaId               String
  userId                  String
  tipo                    String
  rifContraparte          String
  nombreContraparte       String
  numeroFactura           String?
  numeroControl           String?
  ncf                     String?
  fechaEmision            DateTime
  fechaRegistro           DateTime @default(now())
  monedaOriginal          String   @default("VES")
  baseImponible           Float    @default(0)
  montoExento             Float    @default(0)
  montoExonerado          Float    @default(0)
  alicuotaIVA             Float    @default(16.0)
  montoIVA                Float    @default(0)
  porcentajeRetencionIVA  Float?
  montoRetencionIVA       Float?
  tarifaISLRCodigo        String?
  porcentajeRetencionISLR Float?
  baseRetencionISLR       Float?
  montoRetencionISLR      Float?
  // IGTF (Impuesto a las Grandes Transacciones Financieras, 3%): se activa si el
  // pago se hizo en divisas/cripto, o si la empresa es contribuyente especial y
  // el pago fue en efectivo. Se registra como gasto no recuperable.
  pagoDivisaOCripto       Boolean  @default(false)
  pagoEfectivo            Boolean  @default(false)
  porcentajeIGTF          Float?
  montoIGTF               Float?
  subtotal                Float    @default(0)
  total                   Float    @default(0)
  totalRetencion          Float    @default(0)
  totalAPagar             Float    @default(0)
  tasaCambio              Float?
  totalMonedaFuncional    Float    @default(0)
  descripcion             String?
  imagenUrl               String?
  imagenData              String?
  // Solo relevante cuando tipo es NOTA_CREDITO o NOTA_DEBITO: indica si la nota
  // afecta una venta (true) o una compra (false), para el débito/crédito fiscal
  // de la declaración de IVA. Se ignora para los demás tipos.
  ncfAfectaVenta          Boolean  @default(true)
  asiento                 Asiento?
  estado                  String   @default("REGISTRADA")
  // Cuentas por cobrar/pagar: se actualizan al registrar pagos (ver modelo Pago).
  // Solo aplican a facturas tipo VENTA (CxC) y COMPRA (CxP); GASTO_MENOR se
  // paga de contado por caja chica y no genera partida abierta.
  montoPagado             Float    @default(0)
  estadoPago              String   @default("PENDIENTE") // PENDIENTE | PARCIAL | PAGADA
  pagos                   Pago[]
  empresa                 Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario                 User     @relation(fields: [userId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([empresaId, tipo, fechaEmision])
  @@index([empresaId, ncf])
}

model Asiento {
  id          String         @id @default(cuid())
  empresaId   String
  userId      String
  numero      Int
  fecha       DateTime
  descripcion String
  referencia  String?
  tipo        String         @default("MANUAL")
  facturaId   String?        @unique
  fuente      String         @default("manual")
  lineas      AsientoLinea[]
  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario     User           @relation(fields: [userId], references: [id])
  factura     Factura?       @relation(fields: [facturaId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([empresaId, fecha])
  @@index([empresaId, numero])
}

model AsientoLinea {
  id          String   @id @default(cuid())
  asientoId   String
  cuentaId    String
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  debit       Float    @default(0)
  credit      Float    @default(0)
  descripcion String?
  asiento     Asiento  @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([asientoId])
  @@index([cuentaId])
}

model Ejercicio {
  id                String    @id @default(cuid())
  empresaId         String
  ano               Int
  estado            String    @default("ABIERTO")
  fechaInicio       DateTime
  fechaCierre       DateTime
  asientoCierreId   String?
  asientoAperturaId String?
  utilidadNeta      Float?
  islrEstimado      Float?
  cerradoPor        String?
  cerradoEn         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, ano])
  @@index([empresaId, estado])
}

model ConciliacionBanco {
  id                  String   @id @default(cuid())
  empresaId           String
  cuentaId            String
  mes                 Int
  ano                 Int
  saldoInicialLibro   Float    @default(0)
  saldoInicialBanco   Float    @default(0)
  saldoFinalLibro     Float    @default(0)
  saldoFinalBanco     Float    @default(0)
  depositosEnTransito Float    @default(0)
  chequesPendientes   Float    @default(0)
  notasCredito        Float    @default(0)
  notasDebito         Float    @default(0)
  estado              String   @default("PENDIENTE")
  diferencia          Float    @default(0)
  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cuenta      Cuenta            @relation(fields: [cuentaId], references: [id])
  movimientos MovimientoBanco[]

  @@unique([empresaId, cuentaId, mes, ano])
  @@index([empresaId, mes, ano])
}

model MovimientoBanco {
  id             String   @id @default(cuid())
  conciliacionId String
  fecha          DateTime
  descripcion    String
  referencia     String?
  monto          Float
  tipo           String
  conciliado     Boolean  @default(false)
  asientoLineaId String?
  createdAt      DateTime @default(now())

  conciliacion ConciliacionBanco @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)

  @@index([conciliacionId])
  @@index([conciliacionId, conciliado])
}

// ───────────────────────────────────────────────────────────────────────
//  FACTURACIÓN DE VENTA
// ───────────────────────────────────────────────────────────────────────

model Cliente {
  id        String   @id @default(cuid())
  empresaId String
  rif       String
  nombre    String
  direccion String?
  telefono  String?
  email     String?
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, rif])
}

// Correlativo atómico por empresa y tipo de documento (ej. FACTURA_VENTA),
// usado para numerar facturas emitidas sin colisionar con numeroControl/numeroFactura
// de facturas registradas (compra/venta ya emitidas por terceros).
model SecuenciaDocumento {
  id              String   @id @default(cuid())
  empresaId       String
  tipo            String
  siguienteNumero Int      @default(1)
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, tipo])
}

// ───────────────────────────────────────────────────────────────────────
//  CUENTAS POR COBRAR / CUENTAS POR PAGAR (registro de pagos)
// ───────────────────────────────────────────────────────────────────────

// Pago aplicado a una factura de VENTA (cobro de cliente) o COMPRA (pago a
// proveedor). Es el subledger detrás de las cuentas de control CXC_CLIENTES /
// CXP_PROVEEDORES: la factura mantiene montoPagado/estadoPago como resumen.
model Pago {
  id         String   @id @default(cuid())
  empresaId  String
  facturaId  String
  userId     String
  monto      Float
  fecha      DateTime @default(now())
  metodoPago String   @default("TRANSFERENCIA") // TRANSFERENCIA | EFECTIVO | PAGO_MOVIL | ZELLE | TARJETA | CHEQUE | OTRO
  referencia String?
  cuentaId   String? // cuenta de banco/caja usada, si se generó asiento
  asientoId  String?  @unique
  factura    Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario    User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([facturaId])
  @@index([empresaId, fecha])
}

// ───────────────────────────────────────────────────────────────────────
//  AJUSTE POR INFLACIÓN (reexpresión simplificada, nivel general de precios)
// ───────────────────────────────────────────────────────────────────────

model IndiceInflacion {
  id        String   @id @default(cuid())
  empresaId String
  mes       Int
  ano       Int
  indice    Float
  fuente    String   @default("MANUAL")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([empresaId, mes, ano])
}

model AjusteInflacion {
  id                           String   @id @default(cuid())
  empresaId                    String
  mes                          Int
  ano                          Int
  indiceInicial                Float
  indiceFinal                  Float
  factorReexpresion            Float
  totalReexpresadoActivos      Float    @default(0)
  resultadoExposicionInflacion Float    @default(0)
  estado                       String   @default("BORRADOR")
  asientoId                    String?
  empresa                      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([empresaId, mes, ano])
}

// ───────────────────────────────────────────────────────────────────────
//  NÓMINA BÁSICA
// ───────────────────────────────────────────────────────────────────────

model Empleado {
  id                     String          @id @default(cuid())
  empresaId              String
  cedula                 String
  nombre                 String
  cargo                  String?
  fechaIngreso           DateTime
  salarioBase            Float
  activo                 Boolean         @default(true)
  // LOTTT: egreso y garantía de prestaciones sociales acumulada mes a mes
  // (Art. 142 lit. a) — se compara contra el cálculo retroactivo (lit. c) al liquidar.
  fechaEgreso            DateTime?
  motivoEgreso           String? // RENUNCIA | DESPIDO_JUSTIFICADO | DESPIDO_INJUSTIFICADO | MUTUO_ACUERDO
  prestacionesAcumuladas Float           @default(0)
  empresa                Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles               NominaDetalle[]
  vacaciones             Vacacion[]
  liquidacion            Liquidacion?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([empresaId, cedula])
}

model Nomina {
  id                     String          @id @default(cuid())
  empresaId              String
  mes                    Int
  ano                    Int
  fechaPago              DateTime?
  estado                 String          @default("BORRADOR")
  totalSueldos           Float           @default(0)
  totalBonoAlimentacion  Float           @default(0)
  totalDeducciones       Float           @default(0)
  totalAportesPatronales Float           @default(0)
  totalPrestaciones      Float           @default(0)
  totalUtilidades        Float           @default(0)
  totalNeto              Float           @default(0)
  asientoId              String?
  empresa                Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles               NominaDetalle[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([empresaId, mes, ano])
}

model NominaDetalle {
  id                    String   @id @default(cuid())
  nominaId              String
  empleadoId            String
  salarioBase           Float
  bonoAlimentacion      Float    @default(0)
  deduccionIVSS         Float    @default(0)
  deduccionFAOV         Float    @default(0)
  totalDeducciones      Float    @default(0)
  aportePatronalIVSS    Float    @default(0)
  aportePatronalFAOV    Float    @default(0)
  aportePatronalINCES   Float    @default(0)
  provisionPrestaciones Float    @default(0)
  provisionUtilidades   Float    @default(0)
  netoAPagar            Float    @default(0)
  nomina                Nomina   @relation(fields: [nominaId], references: [id], onDelete: Cascade)
  empleado              Empleado @relation(fields: [empleadoId], references: [id])
  createdAt             DateTime @default(now())

  @@unique([nominaId, empleadoId])
  @@index([nominaId])
}

// Vacaciones disfrutadas (LOTTT Art. 190-192): 15 días de disfrute + 1 día
// adicional por cada año de servicio a partir del segundo (máx. 15
// adicionales), y bono vacacional con el mismo esquema de días.
model Vacacion {
  id                  String   @id @default(cuid())
  empresaId           String
  empleadoId          String
  fechaInicio         DateTime
  fechaFin            DateTime
  diasDisfrutados     Float
  montoVacaciones     Float
  montoBonoVacacional Float
  asientoId           String?  @unique
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleado            Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([empleadoId])
}

// Liquidación final de un empleado (LOTTT Art. 142 y 92). Un solo registro
// por empleado (no se permite re-liquidar).
model Liquidacion {
  id                        String   @id @default(cuid())
  empresaId                 String
  empleadoId                String   @unique
  fechaEgreso               DateTime
  motivoEgreso              String
  aniosServicio             Float
  salarioIntegralDiario     Float
  prestacionesSociales      Float
  vacacionesVencidas        Float
  vacacionesFraccionadas    Float
  bonoVacacionalFraccionado Float
  utilidadesFraccionadas    Float
  indemnizacionDespido      Float    @default(0)
  totalLiquidacion          Float
  asientoId                 String?  @unique
  empresa                   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleado                  Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
}

// ───────────────────────────────────────────────────────────────────────
//  ACTIVOS FIJOS Y DEPRECIACIÓN
// ───────────────────────────────────────────────────────────────────────

model ActivoFijo {
  id                    String                   @id @default(cuid())
  empresaId             String
  nombre                String
  cuentaActivoId        String
  costoAdquisicion      Float
  fechaAdquisicion      DateTime
  vidaUtilMeses         Int
  valorResidual         Float                    @default(0)
  metodoDepreciacion    String                   @default("LINEA_RECTA")
  depreciacionAcumulada Float                    @default(0)
  estado                String                   @default("ACTIVO")
  empresa               Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos           MovimientoDepreciacion[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([empresaId, estado])
}

model MovimientoDepreciacion {
  id                String     @id @default(cuid())
  activoFijoId      String
  mes               Int
  ano               Int
  montoDepreciado   Float
  valorLibroDespues Float
  asientoId         String?
  activoFijo        ActivoFijo @relation(fields: [activoFijoId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())

  @@unique([activoFijoId, mes, ano])
}

// ───────────────────────────────────────────────────────────────────────
//  INVENTARIO / KARDEX (costeo promedio ponderado)
// ───────────────────────────────────────────────────────────────────────

model Producto {
  id                  String                 @id @default(cuid())
  empresaId           String
  codigo              String
  nombre              String
  descripcion         String?
  unidadMedida        String                 @default("UND")
  cuentaInventarioId  String
  costoPromedioActual Float                  @default(0)
  cantidadActual      Float                  @default(0)
  activo              Boolean                @default(true)
  empresa             Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos         MovimientoInventario[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([empresaId, codigo])
}

model MovimientoInventario {
  id                 String   @id @default(cuid())
  productoId         String
  tipo               String // ENTRADA | SALIDA | AJUSTE
  cantidad           Float
  costoUnitario      Float
  costoTotal         Float
  cantidadSaldo      Float
  costoPromedioSaldo Float
  facturaId          String?
  motivo             String?
  asientoId          String?
  fecha              DateTime @default(now())
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([productoId, fecha])
}

// ───────────────────────────────────────────────────────────────────────
//  LIBRO DE ACCIONISTAS Y LIBRO DE ACTAS (registro societario, Código de Comercio)
// ───────────────────────────────────────────────────────────────────────

model Accionista {
  id             String   @id @default(cuid())
  empresaId      String
  nombre         String
  identificacion String // cédula o RIF
  numeroAcciones Float
  fechaIngreso   DateTime @default(now())
  activo         Boolean  @default(true)
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, identificacion])
}

// Correlativo de actas por empresa. accionesRepresentadas se usa junto con
// el total de acciones vigente (suma de Accionista.numeroAcciones activos)
// para calcular el quórum de la asamblea.
model ActaAsamblea {
  id                    String   @id @default(cuid())
  empresaId             String
  numero                Int
  fecha                 DateTime
  tipo                  String // ORDINARIA | EXTRAORDINARIA
  lugar                 String?
  agenda                String
  acuerdos              String
  asistentes            String // texto libre: nombres de accionistas/representantes presentes
  accionesRepresentadas Float    @default(0)
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@unique([empresaId, numero])
}

// ───────────────────────────────────────────────────────────────────────
//  AUDITORÍA (historial de acciones sensibles)
// ───────────────────────────────────────────────────────────────────────

// Registro de acciones sensibles (cierre/reapertura de ejercicios,
// liquidaciones, cambios de rol, desactivación de registros, edición de
// la empresa). userEmail se guarda denormalizado para que el registro
// siga siendo legible aunque el usuario luego se elimine o cambie de email.
model AuditLog {
  id        String   @id @default(cuid())
  empresaId String
  userId    String?
  userEmail String
  accion    String
  entidad   String?
  entidadId String?
  detalle   String?
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
//  NOTIFICACIONES POR EMAIL
// ───────────────────────────────────────────────────────────────────────

// Cola de notificaciones (vencimientos fiscales próximos, facturas por
// cobrar vencidas). El envío real requiere configurar RESEND_API_KEY como
// variable de entorno — sin eso, quedan generadas pero en estado ERROR con
// un mensaje explicando qué falta. entidadId se usa para no duplicar el
// aviso de un mismo vencimiento/factura ya notificado.
model Notificacion {
  id           String    @id @default(cuid())
  empresaId    String
  tipo         String // VENCIMIENTO_FISCAL | CXC_VENCIDA
  destinatario String
  asunto       String
  cuerpo       String
  entidadId    String?
  estado       String    @default("PENDIENTE") // PENDIENTE | ENVIADA | ERROR
  errorMensaje String?
  enviadaAt    DateTime?
  empresa      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([empresaId, estado])
}

// ═══════════════════════════════════════════════════════════════════════
//  MÓDULO RESTAURANTE — administración diaria de un negocio de comida
// ═══════════════════════════════════════════════════════════════════════
//
//  Este módulo reemplaza el "Excel del negocio": el cierre de caja diario,
//  los gastos del día, las notas de proveedores por pagar, los fiados, la
//  nómina semanal con propinas y los gastos fijos del mes.
//
//  Regla central: todo el negocio piensa en DÓLARES, pero cobra y paga en
//  bolívares a la tasa del día. Por eso cada movimiento de dinero guarda
//  montoUSD, montoVES y la tasa con la que se convirtió; así el histórico
//  no se distorsiona cuando la tasa cambia después.
// ───────────────────────────────────────────────────────────────────────

// Una "caja" donde entra o sale dinero: Zelle, la cuenta del banco en
// bolívares, el efectivo en dólares, la caja en bolívares, el punto de venta.
model RestFondo {
  id           String   @id @default(cuid())
  empresaId    String
  nombre       String
  tipo         String // BANCO | EFECTIVO | DIGITAL | PUNTO_VENTA
  moneda       String   @default("USD") // USD | VES
  saldoInicial Float    @default(0)
  color        String   @default("emerald") // acento visual en la UI
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  // Medio de pago del cierre diario que cae automáticamente en este fondo:
  // ZELLE | EFECTIVO_USD | BS_TRANSFERENCIA | PUNTO_VENTA. Si es null, el
  // fondo solo recibe movimientos manuales (gastos, pagos, ajustes).
  rolCierre    String?
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  movimientos RestMovimientoFondo[]
  gastos      RestGasto[]
  pagos       RestPagoProveedor[]
  nominas     RestNominaSemana[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([empresaId, nombre])
}

// Libro de movimientos de cada fondo. No se escribe a mano: lo generan el
// cierre diario, los gastos, los pagos a proveedores, los cobros y la
// nómina. `origen`/`origenId` permiten deshacer el movimiento si se borra
// el documento que lo originó.
model RestMovimientoFondo {
  id        String    @id @default(cuid())
  empresaId String
  fondoId   String
  fecha     DateTime
  tipo      String // INGRESO | EGRESO
  montoUSD  Float
  montoVES  Float     @default(0)
  tasa      Float     @default(0)
  concepto  String
  origen    String // CIERRE | GASTO | PAGO_PROVEEDOR | COBRO | NOMINA | AJUSTE
  origenId  String?
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fondo     RestFondo @relation(fields: [fondoId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([empresaId, fecha])
  @@index([origen, origenId])
}

// Cierre de caja de un día: cuánto se vendió y por cuál medio de pago.
// Un registro por fecha. `estado` distingue el día en curso (ABIERTO) del
// día ya cuadrado (CERRADO), que es el que impacta los saldos de fondos.
model RestCierreDiario {
  id        String   @id @default(cuid())
  empresaId String
  fecha     DateTime
  tasa      Float // Bs por USD usada ese día

  // Ventas por medio de pago (en la moneda en que se cobraron)
  ventaZelle       Float @default(0) // USD
  ventaEfectivoUSD Float @default(0) // USD
  ventaBs          Float @default(0) // VES — transferencias/pago móvil
  ventaPuntoVenta  Float @default(0) // VES — punto de venta

  // Conteos operativos del día
  numVentas        Int   @default(0)
  numDelivery      Int   @default(0)
  numVentaDirecta  Int   @default(0)
  propinas         Float @default(0) // USD, para repartir en la nómina de la semana

  totalUSD  Float    @default(0) // calculado: todo llevado a USD con `tasa`
  nota      String? // FERIADO, NO SE TRABAJÓ, observaciones del día
  estado    String   @default("ABIERTO") // ABIERTO | CERRADO
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, fecha])
  @@index([empresaId, fecha])
}

// Egreso del día. Cubre tanto la compra suelta (verduras, gas, papelería)
// como el gasto fijo ya generado del mes. Cuando paga una nota de
// proveedor se enlaza con `notaId` para no contar el gasto dos veces.
model RestGasto {
  id          String   @id @default(cuid())
  empresaId   String
  fecha       DateTime
  descripcion String
  categoria   String // ver CATEGORIAS_GASTO en src/lib/restaurante/categorias.ts
  fondoId     String
  montoUSD    Float
  montoVES    Float    @default(0)
  tasa        Float    @default(0)
  referencia  String? // número de transferencia, factura o "EFECTIVO"
  proveedorId String?
  notaId      String?

  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fondo     RestFondo       @relation(fields: [fondoId], references: [id])
  proveedor RestProveedor?  @relation(fields: [proveedorId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([empresaId, fecha])
  @@index([empresaId, categoria])
}

model RestProveedor {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  categoria String   @default("INSUMOS") // PROTEINAS | VERDURAS | BEBIDAS | INSUMOS | SERVICIOS
  telefono  String?
  notas     String?
  activo    Boolean  @default(true)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  notasPorPagar RestNotaProveedor[]
  gastos        RestGasto[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([empresaId, nombre])
}

// Nota/factura que el proveedor deja y queda por pagar (la hoja "CXP").
// Se lleva en USD porque así la negocian; el pago se hace luego en Bs a la
// tasa del día de pago.
model RestNotaProveedor {
  id          String   @id @default(cuid())
  empresaId   String
  proveedorId String
  fecha       DateTime
  numeroNota  String?
  montoUSD    Float
  montoPagado Float    @default(0)
  estado      String   @default("PENDIENTE") // PENDIENTE | ABONADA | PAGADA
  descripcion String?

  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  proveedor RestProveedor       @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  pagos     RestPagoProveedor[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([empresaId, estado])
  @@index([empresaId, fecha])
}

model RestPagoProveedor {
  id         String   @id @default(cuid())
  empresaId  String
  notaId     String
  fondoId    String
  fecha      DateTime
  montoUSD   Float
  montoVES   Float    @default(0)
  tasa       Float    @default(0)
  referencia String?

  empresa   Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nota      RestNotaProveedor @relation(fields: [notaId], references: [id], onDelete: Cascade)
  fondo     RestFondo         @relation(fields: [fondoId], references: [id])
  createdAt DateTime          @default(now())

  @@index([notaId])
}

// Fiado: consumo que un cliente conocido se lleva y paga después
// (la hoja "CXC").
model RestCuentaCobrar {
  id           String   @id @default(cuid())
  empresaId    String
  fecha        DateTime
  cliente      String
  concepto     String?
  montoUSD     Float
  montoCobrado Float    @default(0)
  estado       String   @default("PENDIENTE") // PENDIENTE | ABONADA | COBRADA
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId, estado])
}

// Plantilla de gasto que se repite todos los meses (alquiler, condominio,
// internet, luz, gas, sistema de facturación). El módulo los genera como
// gastos reales al inicio de cada mes con un clic.
model RestGastoFijo {
  id             String   @id @default(cuid())
  empresaId      String
  nombre         String
  categoria      String   @default("GASTO_FIJO")
  montoUSD       Float
  diaVencimiento Int      @default(5) // día del mes en que toca pagarlo
  activo         Boolean  @default(true)
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, nombre])
}

// Personal del local. `pagoBaseSemanal` es el sueldo semanal acordado en
// USD; `recibePropina` marca a quien entra en el reparto del pote.
model RestPersonal {
  id              String   @id @default(cuid())
  empresaId       String
  nombre          String
  cargo           String? // COCINA | MESONERO | DELIVERY | TRANSPORTE | ADMINISTRACION
  pagoBaseSemanal Float    @default(0)
  recibePropina   Boolean  @default(true)
  activo          Boolean  @default(true)
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  lineas    RestNominaLinea[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([empresaId, nombre])
}

// Nómina de una semana (lunes a domingo, como la llevan en el Excel).
// Al crearla el sistema precarga a todo el personal activo con su base y
// reparte las propinas de los cierres diarios de esa semana.
model RestNominaSemana {
  id          String   @id @default(cuid())
  empresaId   String
  fechaInicio DateTime
  fechaFin    DateTime
  estado      String   @default("BORRADOR") // BORRADOR | PAGADA
  fondoId     String?
  fechaPago   DateTime?

  totalBase       Float @default(0)
  totalPropina    Float @default(0)
  totalTransporte Float @default(0)
  totalDelivery   Float @default(0)
  totalDescuento  Float @default(0)
  totalNeto       Float @default(0)

  empresa   Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fondo     RestFondo?        @relation(fields: [fondoId], references: [id])
  lineas    RestNominaLinea[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([empresaId, fechaInicio])
}

model RestNominaLinea {
  id         String @id @default(cuid())
  semanaId   String
  personalId String
  base       Float  @default(0)
  propina    Float  @default(0)
  transporte Float  @default(0)
  delivery   Float  @default(0)
  descuento  Float  @default(0)
  neto       Float  @default(0)

  semana    RestNominaSemana @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  personal  RestPersonal     @relation(fields: [personalId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([semanaId, personalId])
  @@index([semanaId])
}

// Todo lo que sale del inventario sin generar venta: cortesías, producto
// dañado, comida del personal y préstamos a otra sede. Son las hojas
// CORTESIA / PRODUCTOS DAÑADOS / PERSONAL / PRESTAMOS del Excel.
model RestIncidencia {
  id          String   @id @default(cuid())
  empresaId   String
  fecha       DateTime
  tipo        String // CORTESIA | MERMA | CONSUMO_PERSONAL | PRESTAMO_SEDE
  descripcion String
  cantidad    Float    @default(1)
  montoUSD    Float    @default(0)
  referencia  String? // a quién se le dio / a qué sede se prestó
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([empresaId, fecha])
  @@index([empresaId, tipo])
}
