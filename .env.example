# ─── BASE DE DATOS ────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string
# URL del pooler, para la app en producción (mayor concurrencia):
DATABASE_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa, para migraciones (Prisma la necesita sin pooler):
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROYECTO.supabase.co:5432/postgres"

# ─── AUTENTICACIÓN ────────────────────────────────────────────────────
# Secreto de firma de sesiones. Mínimo 32 caracteres.
# Genéralo con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-una-cadena-aleatoria-de-32-caracteres"
