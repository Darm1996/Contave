# ─── BASE DE DATOS SUPABASE ───────────────────────────────────────────
# Obtén estas URLs desde Supabase → Settings → Database → Connection string
# URL directa (para migraciones):
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres"
# URL del pooler (para la app en producción, mayor concurrencia):
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# ─── AUTENTICACIÓN ────────────────────────────────────────────────────
# Genera un secreto aleatorio de al menos 32 caracteres
# Puedes generarlo con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-una-cadena-aleatoria-de-32-caracteres"

# ─── ESCÁNER DE FACTURAS POR IA (REQUERIDO) ───────────────────────────
# El escaneo de facturas (VLM) usa la API de Z.ai. Sin esta variable,
# la función principal de la app falla en producción.
ZAI_API_KEY="tu-api-key-de-z.ai"

# ─── GOOGLE SHEETS (OPCIONAL) ─────────────────────────────────────────
# Solo si vas a usar la sincronización con Google Sheets:
# GOOGLE_SHEETS_CLIENT_EMAIL="tu-sa@proyecto.iam.gserviceaccount.com"
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SPREADSHEET_ID="1ABC123..."
